		"firebase": "^12.10.0",
		"firebase-admin": "^13.6.0",
		"focus-trap-react": "^12.0.0",
		"framer-motion": "^12.35.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"stripe": "^17.7.0"
	},
	"devDependencies": {
