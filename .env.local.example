# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your Apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Development Mode
# Set to "true" to enable mock data (puzzles and users) without needing Firestore data
# This allows you to develop and test without creating 365 puzzles in Firestore
# In production, remove this line or set to "false"
VITE_DEV_MODE=true
